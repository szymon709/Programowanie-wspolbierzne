<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfApp1.Prezentacja"
        Title="Stół Bilardowy" 
        SizeToContent="WidthAndHeight" 
        WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <local:ViewModel/>
    </Window.DataContext>

    <Grid Background="White">
        <StackPanel Margin="20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="Liczba kul:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Text="{Binding LiczbaKul, UpdateSourceTrigger=PropertyChanged}"
                         Width="60"
                         Margin="5"
                         VerticalContentAlignment="Center"/>
                <Button Content="START"
                        Command="{Binding PrzyciskStart}"
                        Width="80"
                        Height="30"
                        Margin="10,0,0,0"
                        Background="LightGreen"
                        FontWeight="Bold"/>
                <Button Content="STOP"
                        Command="{Binding PrzyciskStop}"
                        Width="80"
                        Height="30"
                        Margin="10,0,0,0"
                        Background="LightCoral"
                        FontWeight="Bold"/>
            </StackPanel>

            <Border BorderBrush="Black" BorderThickness="2" HorizontalAlignment="Center">
                <ItemsControl ItemsSource="{Binding Kule}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="600" Height="300" Background="Gainsboro"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Ellipse Fill="Aqua" Stroke="Black" StrokeThickness="1" 
                                     Width="{Binding Srednica}" Height="{Binding Srednica}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Text="{Binding Komunikat}"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"
                       FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>